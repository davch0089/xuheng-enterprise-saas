# HengFlow ERP API
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string

# MySQL：需要预先创建 utf8mb4 数据库
DATABASE_URL=mysql+asyncmy://hengflow:change_me@127.0.0.1:3306/hengflow

# Redis 用于登录令牌和事件；没有 Redis 时可设为 false
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/1

MONGO_ENABLED=false
MONGO_DB_NAME=hengflow
MONGO_URL=mongodb://127.0.0.1:27017/?authSource=hengflow

ALLOW_ORIGINS=http://localhost:5000
REQUEST_LOG_RECORD=true
OPERATION_LOG_RECORD=true

# 仅空数据库首次执行 init 时使用，登录后请立即修改密码
INITIAL_ADMIN_USERNAME=13800000000
INITIAL_ADMIN_PASSWORD=ChangeMe123!

# 可选：阿里云 OSS；留空时附件仍可使用本地存储
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_BASE_URL=

IP_PARSE_ENABLED=false
IP_PARSE_TOKEN=
